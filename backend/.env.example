# Server
NODE_ENV=development
PORT=4000

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net

# Redis (optional — nếu trống thì queue/rate-limit chạy in-memory fallback)
REDIS_URL=

# Auth
JWT_SECRET=replace-with-strong-secret-min-16-chars
JWT_REFRESH_SECRET=replace-with-different-strong-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS — domain frontend được phép gọi API
CORS_ORIGIN=http://localhost:3000

# Field-level encryption key (AES-256, 32 bytes hex)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=<generate-with-the-command-above>

# Google Cloud Vision (OCR) — optional, nếu trống thì OCR dùng stub
GOOGLE_VISION_API_KEY=

# Cloudflare R2 — optional
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=

# Sentry — optional
SENTRY_DSN=

# B2B API (optional — nếu trống, endpoint /api/v1/public/* sẽ từ chối mọi request)
# Generate: openssl rand -hex 32
B2B_API_KEY=
