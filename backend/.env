# Server
NODE_ENV=development
PORT=4000

# Database
MONGODB_URI=mongodb+srv://thuandh30_db_user:FJBMH3XFGGak5iZW@cluster0.pw0cmbw.mongodb.net

# Redis (optional — nếu trống thì queue/rate-limit chạy in-memory fallback)
