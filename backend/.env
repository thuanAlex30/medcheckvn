# Auth
JWT_SECRET=replace-with-strong-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-another-strong-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS — domain frontend được phép gọi API
CORS_ORIGIN=http://localhost:3000

# Field-level encryption key (AES-256, 32 bytes hex)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# Google Cloud Vision (OCR) — optional, nếu trống thì OCR dùng stub
GOOGLE_VISION_API_KEY=

# Cloudflare R2 — optional
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=

# Sentry — optional
SENTRY_DSN=
